{
	"schemaVersion": 1,
	"id": "trustedclients",
	"version": "${version}",
	"name": "Trusted Clients",
	"description": "A lightweight anti-cheat/client-scanning mod which shows client installed mods on the server when a player joins.",
	"authors": ["NoahOnFyre"],
	"contact": {
		"homepage": "https://modrinth.com/mod/trustedclients",
		"sources": "https://github.com/noahonfyre/trustedclients"
	},
	"license": "MIT",
	"icon": "assets/trustedclients/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.nyronium.TrustedClients",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.nyronium.client.TrustedClientside",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.10",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}